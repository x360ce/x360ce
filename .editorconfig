# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

# A newline ends every file. The line ending is decided by .gitattributes: the operating system's by default,
# LF for scripts that run on Linux and macOS, CRLF for Windows command and solution files.
[*]
insert_final_newline = true

[*.{sh,bash,py,dockerfile}]
end_of_line = lf

[Dockerfile]
end_of_line = lf

[*.{sln,slnx,bat,cmd}]
end_of_line = crlf

# tab indentation
[*.{c,h,def}]
indent_style = tab
indent_size = 4

# Trim trailing white spaces
[*.{c,h,def,txt}]
trim_trailing_whitespace = true

# UTF-8
[*.{c,h,def,txt}]
charset=utf-8
