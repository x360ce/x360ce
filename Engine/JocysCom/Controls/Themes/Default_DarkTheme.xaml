<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--  Colors for Dark Theme: Windows 11 dark (WPF Fluent) and VS Code Dark Modern values  -->

	<!--  Transparent Background (unchanged)  -->
	<SolidColorBrush x:Key="BackgroundTransparent" Color="Transparent" />

	<!--  Adjusted Backgrounds  -->
	<SolidColorBrush x:Key="BackgroundWhite" Color="#131313" />
	<!--  Field: what is white in the light theme, a box to type in or tick, a grid, a tree, a document or a chart, set darker than the page (WPF Fluent's ControlOnImageFillColorTertiary)  -->
	<SolidColorBrush x:Key="BackgroundLight" Color="#202020" />
	<!--  Light background in dark theme  -->
	<SolidColorBrush x:Key="BackgroundDark" Color="#454545" />
	<!--  Darker background  -->
	<SolidColorBrush x:Key="BackgroundDarkSelected" Color="#264F78" />
	<!--  Selection background: a muted blue tint, as #C2E7FF is a pale one in the light theme  -->
	<SolidColorBrush x:Key="BackgroundDarkPressed" Color="#272727" />
	<!--  Pressed background  -->
	<SolidColorBrush x:Key="BackgroundTabSelected" Color="#202020" />
	<!--  Selected tab: the tab page colour, so the open tab joins its page  -->
	<SolidColorBrush x:Key="BackgroundHeader" Color="#2D2D2D" />
	<!--  Column header: the top of its shading, which runs down to the page colour  -->

	<!--  Adjusted Special Backgrounds  -->
	<SolidColorBrush x:Key="BackgroundWarning" Color="#442726" />
	<!--  Warning background  -->
	<SolidColorBrush x:Key="BackgroundHelp" Color="#181818" />
	<!--  Help background: darker than the page, as the darkest chrome of VS Code, so coloured help text reads on it  -->

	<!--  Adjusted Borders  -->
	<SolidColorBrush x:Key="BorderDark" Color="#424242" />
	<!--  Border color  -->
	<SolidColorBrush x:Key="BorderGray" Color="#5C5C5C" />
	<!--  Grey border, as a slider thumb's: as far from the border colour toward the secondary text as #acacac in the light theme  -->
	<SolidColorBrush x:Key="BorderField" Color="#212121" />
	<!--  Field edge: the line round a box to type in while the mouse and the focus are elsewhere: the light theme's edge (#DEDEDE) with its lightness inverted  -->
	<SolidColorBrush x:Key="BorderCheck" Color="#131313" />
	<!--  Check box edge: the line round a check box or radio button that is not ticked or chosen, at rest: the box's own colour (BackgroundWhite), so it shows no edge until it is ticked (the field edge), pointed at or focused (the selection colour), as a box to type in  -->
	<SolidColorBrush x:Key="BorderShadow" Color="#2D2D2D" />
	<!--  Shadow line: the outer line of a sunken edge, such as a group's frame, darker than the highlight line inside it  -->
	<SolidColorBrush x:Key="BorderHighlight" Color="#424242" />
	<!--  Highlight line: the inner line of a sunken edge, such as a group's frame, and Windows' 3D highlight: lighter than the shadow line  -->

	<!--  Adjusted Foregrounds  -->
	<SolidColorBrush x:Key="ForegroundBlack" Color="#BFBFBF" />
	<!--  Text foreground: a dimmed white, as Microsoft dark themes use, so the selected tab stands out  -->
	<SolidColorBrush x:Key="ForegroundWarning" Color="#FF99A4" />
	<!--  Error text: an error, a failure or a critical issue  -->
	<SolidColorBrush x:Key="ForegroundCaution" Color="#FFB25C" />
	<!--  Caution text: an issue that needs attention but is not an error  -->
	<SolidColorBrush x:Key="ForegroundInformation" Color="#60CDFF" />
	<!--  Information text: a status or a notice  -->
	<SolidColorBrush x:Key="ForegroundGray" Color="#9D9D9D" />
	<!--  Secondary text  -->
	<SolidColorBrush x:Key="ForegroundUnavailable" Color="#939393" />
	<!--  Unavailable text: a list row whose device is unplugged or switched off: the light theme's (#6C6C6C) with its lightness inverted, 4.5:1 or more on the field, the page and every source tint  -->
	<SolidColorBrush x:Key="ForegroundDisabled" Color="#6F6F6F" />
	<!--  Disabled text, in every control: the light theme's rule, the text at half strength over the page (#BFBFBF over #202020), as a disabled label  -->
	<SolidColorBrush x:Key="ForegroundSuccess" Color="#6CCB5F" />
	<!--  Success text  -->
	<SolidColorBrush x:Key="ForegroundLink" Color="#99EBFF" />
	<!--  Link text: the Windows 11 dark link colour, WPF Fluent's HyperlinkForeground (the default accent's Light3)  -->
	<SolidColorBrush x:Key="ForegroundActive" Color="#6CCB5F" />
	<!--  Active text: what a controller does now: a control's name while it is pressed, a value read from it, and a chart's line at that reading  -->
	<SolidColorBrush x:Key="ForegroundOutput" Color="#60CDFF" />
	<!--  Output text: the value a chart's curve gives for the reading, and the chart's line at that value  -->
	<SolidColorBrush x:Key="ForegroundCode" Color="#6CCB5F" />
	<!--  Code text: a value written as it is typed: a file name, a formula, a setting  -->
	<SolidColorBrush x:Key="ForegroundCommand" Color="#60CDFF" />
	<!--  Command text: the name of a button, tab or box the reader is told to use  -->
	<SolidColorBrush x:Key="ForegroundTab" Color="#BFBFBF" />
	<!--  Unselected tab text: the body text; dimmer fails contrast on the BackgroundDark tab  -->
	<SolidColorBrush x:Key="ForegroundTabSelected" Color="#EDEDED" />
	<!--  Selected tab text, brighter than the rest  -->

	<!--  Adjusted Selection Colors  -->
	<SolidColorBrush x:Key="SelectedForeground" Color="#FFFFFF" />
	<!--  Selected item text  -->
	<SolidColorBrush x:Key="SelectedBackground" Color="#0078D4" />
	<!--  Selected item background  -->
	<SolidColorBrush x:Key="MouseOverBackground" Color="#2D2D2D" />
	<!--  Mouse over background  -->

	<!--  Adjusted State Colors  -->
	<SolidColorBrush x:Key="ColorNormal" Color="#60CDFF" />
	<!--  Normal state  -->
	<SolidColorBrush x:Key="ColorActive" Color="#6CCB5F" />
	<!--  Active state  -->
	<SolidColorBrush x:Key="ColorOver" Color="#FCE100" />
	<!--  Mouse over  -->
	<SolidColorBrush x:Key="ColorRecord" Color="#FF99A4" />
	<!--  Record state  -->

	<!--  Adjusted Chart Colors  -->
	<SolidColorBrush x:Key="ColorCurve" Color="#FF99A4" />
	<!--  Curve: the line a chart draws through every reading, as its settings shape it  -->

	<!--  Adjusted Brand Colors  -->
	<SolidColorBrush x:Key="ColorBrand" Color="#3ACDFF" />
	<!--  Brand core  -->
	<SolidColorBrush x:Key="ColorBrandCyan" Color="#49B8ED" />
	<!--  Brand cyan  -->
	<SolidColorBrush x:Key="ColorBrandViolet" Color="#897FD1" />
	<!--  Brand violet  -->
	<SolidColorBrush x:Key="ColorBrandHighlight" Color="#B6F3FF" />
	<!--  Brand highlight  -->

	<!--  Adjusted SolidColorBrush_BFF  -->
	<SolidColorBrush x:Key="SolidColorBrush_BFF" Color="#FFFFFFFF" />
	<!--  Changed from black to white  -->

	<!--  Adjusted HUE Color Brushes  -->
	<!--  HUE Color Degrees - Light (dark shades for dark theme)  -->
	<SolidColorBrush x:Key="SolidColorBrush_000L">#2E2E2E</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_030L">#2E2A29</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_060L">#2E2E29</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_090L">#2A2E29</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_120L">#292E29</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_150L">#292E2A</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_180L">#292E2E</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_210L">#292A2E</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_240L">#2A292E</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_270L">#2E292E</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_300L">#2E292A</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_330L">#2E2929</SolidColorBrush>

	<!--  HUE Color Degrees - Dark (bright shades for dark theme)  -->
	<SolidColorBrush x:Key="SolidColorBrush_000D">#D16969</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_030D">#D19A69</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_060D">#D1D169</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_090D">#9AD169</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_120D">#69D169</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_150D">#69D19A</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_180D">#69D1D1</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_210D">#699AD1</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_240D">#6969D1</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_270D">#9A69D1</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_300D">#D169D1</SolidColorBrush>
	<SolidColorBrush x:Key="SolidColorBrush_330D">#D1699A</SolidColorBrush>

	<!--  Adjusted GradientBrush: column headers, BackgroundHeader to BackgroundLight as in the light theme  -->
	<LinearGradientBrush x:Key="GradientBrushStyle" StartPoint="1,0" EndPoint="1,1">
		<GradientStop Offset="0" Color="#2D2D2D" />
		<GradientStop Offset="1" Color="#202020" />
	</LinearGradientBrush>

</ResourceDictionary>
