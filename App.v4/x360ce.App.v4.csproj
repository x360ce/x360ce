<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The target is net462 on purpose (v5 targets net48). A net462 build runs on the installed
         .NET Framework 4.8 runtime, an in-place upgrade, so users already get 4.8 behaviour; the
         target only limits the compile-time API surface. Move to net48 only when a needed API
         forces it. -->
    <TargetFramework>net462</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>x360ce.App</RootNamespace>
    <AssemblyName>x360ce</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\Resources\Images\shared\app\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The item lists below are the whole content: nothing on disk is compiled or embedded by
         being there, so a file dropped into the folder cannot change the build unlisted.
         After any change to this file, compare Assembly.GetManifestResourceNames() of the built
         program with the one before. A changed name builds green and then throws
         MissingManifestResourceException in InitializeComponent. The embedded files are named
         x360ce.App.Resources.* after RootNamespace, which the code looks them up by, and
         Documents/App_0_Release.ps1 (Test-EmbeddedSignatures) prints them without that prefix,
         so RootNamespace stays x360ce.App. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Properties/AssemblyInfo.cs carries the version and attributes, as before. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The signing and packaging scripts read bin\Release, bin\Release_x86 and
         bin\Release_x64, so the output folders keep their names and no framework folder is
         added beneath them. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <!-- The title and error reports show the build date, read from the time the linker writes
         into the file's header. A deterministic build writes a content hash there instead. -->
    <Deterministic>false</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>bin\Debug_x86\</OutputPath>
    <DefineConstants>DEBUG;TRACE;CODE_ANALYSIS</DefineConstants>
    <PlatformTarget>x86</PlatformTarget>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\Release_x86\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\Debug_x64\</OutputPath>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\Release_x64\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>
