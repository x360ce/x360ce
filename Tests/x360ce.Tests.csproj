<Project Sdk="Microsoft.NET.Sdk">

	<!--
	One test project covers the whole solution, per the qa-tester rule that the test tree
	must not be more fractured than the product tree. A split is only justified by a
	different target framework, headless CI, or scale, and none apply here: App.v3,
	App.v4 and Engine all target .NET Framework 4.6.2.

	App.v3 and App.v4 both produce x360ce.exe with the namespace x360ce.App, so they
	cannot both be referenced from one assembly. They are driven as processes through
	System.Windows.Automation instead, which is how a user meets them anyway.
	-->

	<PropertyGroup>
		<TargetFramework>net462</TargetFramework>
		<IsTestProject>true</IsTestProject>
		<IsPackable>false</IsPackable>
		<RootNamespace>x360ce.Tests</RootNamespace>
		<AssemblyName>x360ce.Tests</AssemblyName>
		<Platforms>AnyCPU</Platforms>
		<!-- Line numbers in stack traces are the subject of CrashReportTest. -->
		<DebugType>full</DebugType>
		<!--
		Optimisation is required in every configuration, not just Release. Without it the
		compiler keeps locals rooted for the debugger even after they are set to null, so a
		weak reference never dies and every disposal test passes whether or not the object
		was actually released. The 5.x MemoryLeakHelper carries the same warning.
		-->
		<Optimize>true</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<!-- UI automation is in-box; no driver process and no extra package. -->
		<Reference Include="UIAutomationClient" />
		<Reference Include="UIAutomationTypes" />
		<Reference Include="WindowsBase" />
		<!-- The shared control helpers cover both toolkits, so both have to resolve here. -->
		<Reference Include="PresentationCore" />
		<Reference Include="PresentationFramework" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.Configuration" />
		<!-- Settings rows are entity objects, so their base type has to resolve here. -->
		<Reference Include="System.Data.Entity" />
		<!-- The test controller reports a DirectInput state, so the type has to resolve here too. -->
		<Reference Include="SharpDX">
			<HintPath>..\App.v4\Resources\SharpDX\SharpDX.dll</HintPath>
		</Reference>
		<Reference Include="SharpDX.DirectInput">
			<HintPath>..\App.v4\Resources\SharpDX\SharpDX.DirectInput.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
		<PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
		<PackageReference Include="System.Resources.Extensions" Version="4.6.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Engine\x360ce.Engine.csproj" />
		<!--
		App.v4 only. Referencing App.v3 as well is what is impossible, because both build
		x360ce.exe in the namespace x360ce.App. One of them can be referenced, and that is
		what makes the controller picture geometry testable.
		-->
		<ProjectReference Include="..\App.v4\x360ce.App.v4.csproj" />
	</ItemGroup>

</Project>
