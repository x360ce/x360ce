<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>x360ce.App</RootNamespace>
    <AssemblyName>x360ce</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The item lists below are the whole content: nothing on disk is compiled or embedded by
         being there, so a file dropped into the folder cannot change the build unlisted. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Properties/AssemblyInfo.cs carries the version and attributes, as before. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The signing and packaging scripts read bin\Release_x86 and bin\Release_x64, so the
         output folders keep their names and no framework folder is added beneath them. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>bin\Debug_x86\</OutputPath>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\Release_x86\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
