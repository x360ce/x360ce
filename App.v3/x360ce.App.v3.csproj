  <!--
    The native libraries this application embeds, built in its own configuration and in both
    bitnesses, because both are embedded whatever it is built as. Building this project from a
    clean tree therefore builds everything it carries, and a Debug build carries Debug libraries
    with their symbols. The solution's configuration map is left out, and each library keeps
    the configuration and bitness asked for here for its own references too: inside a solution
    build, and inside Visual Studio, a reference missing from the map is otherwise built at its
    project's defaults, Debug and 32 bit, and a Release or 64 bit library fails to link.
    A library that is already built is not relinked unless its sources changed, so a release
    that signs the libraries before building this project keeps them signed.
  -->
  <ItemGroup>
    <NativeLibraryProject Include="..\Native\dinput8\dinput8.vcxproj" />
    <NativeLibraryProject Include="..\Native\x360ce\x360ce.vcxproj" />
    <!-- A change to the native sources makes Visual Studio build this project again, and so the libraries. -->
    <UpToDateCheckInput Include="..\Native\**\*.cpp;..\Native\**\*.c;..\Native\**\*.h;..\Native\**\*.def;..\Native\**\*.rc;..\Native\**\*.vcxproj" Exclude="..\Native\**\obj*\**;..\Native\**\bin*\**" Set="Native" />
  </ItemGroup>
  <PropertyGroup>
    <SolutionGlobalProperties>CurrentSolutionConfigurationContents;SolutionDir;SolutionExt;SolutionFileName;SolutionName;SolutionPath</SolutionGlobalProperties>
    <NativeLibraryProperties>Configuration=$(Configuration);ShouldUnsetParentConfigurationAndPlatform=false</NativeLibraryProperties>
  </PropertyGroup>
  <Target Name="BuildNativeLibraries" BeforeTargets="StageGeneratedResources">
    <MSBuild Projects="@(NativeLibraryProject)" Targets="Build" Properties="$(NativeLibraryProperties);Platform=Win32" RemoveProperties="$(SolutionGlobalProperties)" />
    <MSBuild Projects="@(NativeLibraryProject)" Targets="Build" Properties="$(NativeLibraryProperties);Platform=x64" RemoveProperties="$(SolutionGlobalProperties)" />
  </Target>
  <Target Name="CleanNativeLibraries" AfterTargets="Clean">
    <MSBuild Projects="@(NativeLibraryProject)" Targets="Clean" Properties="$(NativeLibraryProperties);Platform=Win32" RemoveProperties="$(SolutionGlobalProperties)" />
    <MSBuild Projects="@(NativeLibraryProject)" Targets="Clean" Properties="$(NativeLibraryProperties);Platform=x64" RemoveProperties="$(SolutionGlobalProperties)" />
  </Target>
  <!--
    A Debug build keeps the native libraries beside the executable, so a debugger finds their
    symbols. Nothing is copied for a Release build.
  -->
  <Target Name="CopyNativeDebugLibraries" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug' And '$(PlatformTarget)' != 'AnyCPU'">
    <PropertyGroup>
      <NativeDebugFolder Condition="'$(PlatformTarget)' == 'x86'">$(MSBuildThisFileDirectory)..\Native\x360ce\bin\Debug\</NativeDebugFolder>
      <NativeDebugFolder Condition="'$(PlatformTarget)' == 'x64'">$(MSBuildThisFileDirectory)..\Native\x360ce\bin64\Debug\</NativeDebugFolder>
    </PropertyGroup>
    <ItemGroup>
      <NativeDebugLibrary Include="$(NativeDebugFolder)*.dll;$(NativeDebugFolder)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeDebugLibrary)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <!--
    Files produced by the build and embedded into this application. They are staged in
    the intermediate folder, which MSBuild already keeps separate per configuration and
    per platform, so a Debug build and a Release build cannot overwrite each other's
    copy the way a single folder shared by every build did. LogicalName fixes the name
    each file carries inside the assembly, so where a file is staged no longer decides
    what the running application looks it up by.
  -->
  <PropertyGroup>
    <MissingResourceHint>. The native libraries are built by BuildNativeLibraries above; the build output before this line says why this one was not.</MissingResourceHint>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Both bitnesses are embedded whatever this application is built as, because it
      extracts the one matching the game into the game folder and the one matching
      itself into its own folder. The unsuffixed name is the 32 bit file under a
      second name, which is why one built file appears here twice.
    -->
    <GeneratedResource Include="$(MSBuildThisFileDirectory)..\Native\dinput8\bin\$(Configuration)\dinput8.dll">
      <EmbeddedName>dinput.dll</EmbeddedName>
    </GeneratedResource>
    <GeneratedResource Include="$(MSBuildThisFileDirectory)..\Native\dinput8\bin\$(Configuration)\dinput8.dll">
      <EmbeddedName>dinput_x86.dll</EmbeddedName>
    </GeneratedResource>
    <GeneratedResource Include="$(MSBuildThisFileDirectory)..\Native\dinput8\bin64\$(Configuration)\dinput8.dll">
      <EmbeddedName>dinput_x64.dll</EmbeddedName>
    </GeneratedResource>
    <GeneratedResource Include="$(MSBuildThisFileDirectory)..\Native\x360ce\bin\$(Configuration)\xinput1_3.dll">
      <EmbeddedName>xinput.dll</EmbeddedName>
    </GeneratedResource>
    <GeneratedResource Include="$(MSBuildThisFileDirectory)..\Native\x360ce\bin\$(Configuration)\xinput1_3.dll">
      <EmbeddedName>xinput_x86.dll</EmbeddedName>
    </GeneratedResource>
    <GeneratedResource Include="$(MSBuildThisFileDirectory)..\Native\x360ce\bin64\$(Configuration)\xinput1_3.dll">
      <EmbeddedName>xinput_x64.dll</EmbeddedName>
    </GeneratedResource>
  </ItemGroup>
  <Target Name="StageGeneratedResources" AfterTargets="ResolveReferences" BeforeTargets="PrepareResources">
    <ItemGroup>
      <!-- Taken from the resolved reference rather than a second copy of the path. -->
      <GeneratedResource Include="@(ReferencePath)" Condition="'%(Filename)%(Extension)' == 'x360ce.Engine.dll'">
        <EmbeddedName>x360ce.Engine.dll</EmbeddedName>
      </GeneratedResource>
      <!--
        The symbols of the same library. A library loaded from bytes has no file on disk for
        the runtime to find symbols beside, and cannot use symbols built into it either, so
        without carrying them here every frame inside it is reported with no line.
      -->
      <GeneratedResource Include="@(ReferencePath->'%(RootDir)%(Directory)%(Filename).pdb')" Condition="'%(Filename)' == 'x360ce.Engine' And Exists('%(RootDir)%(Directory)%(Filename).pdb')">
        <EmbeddedName>x360ce.Engine.pdb</EmbeddedName>
      </GeneratedResource>
    </ItemGroup>
    <Error Condition="!Exists('%(GeneratedResource.FullPath)')" Text="Missing build output: %(GeneratedResource.FullPath)$(MissingResourceHint)" />
    <Copy SourceFiles="@(GeneratedResource)" DestinationFiles="@(GeneratedResource->'$(IntermediateOutputPath)Embedded\%(EmbeddedName)')" />
    <ItemGroup>
      <EmbeddedResource Include="@(GeneratedResource->'$(IntermediateOutputPath)Embedded\%(EmbeddedName)')">
        <LogicalName>$(RootNamespace).Resources.%(GeneratedResource.EmbeddedName)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
