@echo off
:: Generate svnrev.h from git history.
:: Drop-in replacement for the legacy SVN-based svnrev.exe stamper.
setlocal EnableExtensions EnableDelayedExpansion

set "OUT=%~dp0svnrev.h"

:: Defaults if git is missing or this is not a working copy.
set "REV=0"
set "REVDATE=0000-00-00"
set "MODIFIED=0"

:: What the library is built from, as seen from this folder; this script only numbers it. The number is the count of
:: commits up to the last one that changed these, so a commit elsewhere in the repository leaves the library, its
:: version and its signature as they were, and users are not asked to update a library that has not changed.
set SOURCES="." "../Common" "../InputHook" "../../MinHook" ":(exclude)genrev.cmd"

where git >nul 2>nul
if not errorlevel 1 (
    for /f "delims=" %%r in ('git -C "%~dp0." log -1 --format^=%%H -- %SOURCES% 2^>nul') do (
        for /f "delims=" %%i in ('git -C "%~dp0." rev-list --count %%r 2^>nul') do set "REV=%%i"
        for /f "delims=" %%i in ('git -C "%~dp0." log -1 --date^=short --format^=%%cd %%r 2^>nul') do set "REVDATE=%%i"
    )
    git -C "%~dp0." diff --quiet HEAD -- %SOURCES% 2>nul
    if errorlevel 1 set "MODIFIED=1"
)

:: REVSTAMP = REVDATE with dashes stripped, "L" suffix for long literal.
set "REVSTAMP=!REVDATE:-=!"

:: Written beside the header and moved over it only when the content differs. Rewriting an
:: unchanged header would give it a new time, so every build would recompile and relink the
:: library, and a build after signing would replace the signed library with an unsigned one.
::
:: Each configuration writes its own file, named by the first argument. Both platforms build side
:: by side, and with one shared name each truncated the other's half-written file, so a torn
:: header was moved into place and the other platform failed to compile against it.
set "NEW=%OUT%.%~1.new"
> "%NEW%" echo /* Generated by genrev.cmd from git. Do not edit. */
>> "%NEW%" echo #ifndef SVN_REV_H
>> "%NEW%" echo #define SVN_REV_H
>> "%NEW%" echo.
>> "%NEW%" echo #define SVN_REV         !REV!
>> "%NEW%" echo #define SVN_REVSTR      "!REV!"
>> "%NEW%" echo #define SVN_REVDATE     "!REVDATE!"
>> "%NEW%" echo #define SVN_REVSTAMP    !REVSTAMP!L
>> "%NEW%" echo #define SVN_REVMODIFIED !MODIFIED!
>> "%NEW%" echo.
>> "%NEW%" echo #endif /* SVN_REV_H */

:: A header another platform is compiling against cannot be replaced; it keeps what it has.
fc /b "%NEW%" "%OUT%" >nul 2>nul
if errorlevel 1 (move /y "%NEW%" "%OUT%" >nul 2>nul || del "%NEW%") else (del "%NEW%")

endlocal
exit /b 0
