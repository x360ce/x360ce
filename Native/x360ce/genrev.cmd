@echo off
:: Generate svnrev.h from git history.
:: Drop-in replacement for the legacy SVN-based svnrev.exe stamper.
setlocal EnableExtensions EnableDelayedExpansion

set "OUT=%~dp0svnrev.h"

:: Defaults if git is missing or this is not a working copy.
set "REV=0"
set "REVDATE=0000-00-00"
set "MODIFIED=0"

where git >nul 2>nul
if not errorlevel 1 (
    for /f "delims=" %%i in ('git rev-list --count HEAD 2^>nul') do set "REV=%%i"
    for /f "delims=" %%i in ('git log -1 --date^=short --format^=%%cd 2^>nul') do set "REVDATE=%%i"
    git diff --quiet HEAD -- 2>nul
    if errorlevel 1 set "MODIFIED=1"
)

:: REVSTAMP = REVDATE with dashes stripped, "L" suffix for long literal.
set "REVSTAMP=!REVDATE:-=!"

:: Written beside the header and moved over it only when the content differs. Rewriting an
:: unchanged header would give it a new time, so every build would recompile and relink the
:: library, and a build after signing would replace the signed library with an unsigned one.
set "NEW=%OUT%.new"
> "%NEW%" echo /* Generated by genrev.cmd from git. Do not edit. */
>> "%NEW%" echo #ifndef SVN_REV_H
>> "%NEW%" echo #define SVN_REV_H
>> "%NEW%" echo.
>> "%NEW%" echo #define SVN_REV         !REV!
>> "%NEW%" echo #define SVN_REVSTR      "!REV!"
>> "%NEW%" echo #define SVN_REVDATE     "!REVDATE!"
>> "%NEW%" echo #define SVN_REVSTAMP    !REVSTAMP!L
>> "%NEW%" echo #define SVN_REVMODIFIED !MODIFIED!
>> "%NEW%" echo.
>> "%NEW%" echo #endif /* SVN_REV_H */

fc /b "%NEW%" "%OUT%" >nul 2>nul
if errorlevel 1 (move /y "%NEW%" "%OUT%" >nul) else (del "%NEW%")

endlocal
exit /b 0
